{
  "name": "mockjet-playwright",
  "version": "1.0.0",
  "description": "Playwright automation framework for the MockJet flight booking application",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
